  "hooks": {
    "SessionStart": [
      {
        "async": false,
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${QODER_PLUGIN_ROOT}/bin/sysagent_hook.py",
              "qoder",
              "SessionStart"
            ],
            "name": "sysagent-session-start",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "async": true,
